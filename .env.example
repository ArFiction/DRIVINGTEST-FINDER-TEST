# Copy to .env for local runs (load with: set -a; source .env; set +a)
# In GitHub Actions these live in repo Settings -> Secrets and variables.

# --- Required: identity DVSA asks for before it shows any dates ---
DVSA_LICENCE_NUMBER=ABCDE123456AB7CD
# Theory test pass certificate number (needed for the book-a-test journey)
DVSA_THEORY_NUMBER=12345678

# --- Where to look ---
# Postcode or town searched on the "find a test centre" step (default: AL2 1UX)
DVSA_TEST_CENTRE=AL2 1UX
# Optional: pick the centre whose name contains this text (else first result)
DVSA_CENTRE_MATCH=
# Test category (default: car)
DVSA_TEST_TYPE=car

# --- Human/fingerprint tuning (optional; sensible defaults) ---
# Set to "off" to disable the WebGL GPU-string override (do this if you run on
# real hardware with a genuine GPU, so the real value shows through).
DVSA_WEBGL_SPOOF=
# Override the spoofed GPU strings if you want them to match your own machine.
DVSA_WEBGL_VENDOR=
DVSA_WEBGL_RENDERER=

# --- Optional: only alert for dates inside this window (YYYY-MM-DD) ---
# Defaults: earliest = today, latest = today + 6 months.
DVSA_EARLIEST_DATE=
DVSA_LATEST_DATE=

# --- Alerts: configure at least one channel ---
# ntfy.sh: pick a hard-to-guess topic, then subscribe in the ntfy phone app.
NTFY_TOPIC=
NTFY_SERVER=
# Or any endpoint accepting a JSON POST (Discord webhooks work directly).
ALERT_WEBHOOK_URL=
